{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@chitchat/types": ["../packages/types/index.ts"],
      "@chitchat/e2ee": ["../packages/e2ee/src/index.ts"]
    }
  },
  "include": ["src", "../packages/types", "../packages/e2ee/src"],
  // packages/e2ee's own test suite (vitest) is that package's concern, run
  // via its own `npm test` — pulling it into the app's build coupled a
  // frontend build failure to whether `vitest` happened to be installed in
  // packages/e2ee/node_modules, which is exactly what broke the Render
  // deploy (see the prebuild script in package.json for the actual fix to
  // that; this exclude just stops re-typechecking unrelated test code here).
  "exclude": ["../packages/e2ee/src/__tests__"]
}
