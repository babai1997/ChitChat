# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
# Day-to-day working DB — dev server + `migrate dev` use this by default.
DATABASE_URL="postgresql://user:password@localhost:5432/staging?schema=public"

# The real prod database — only ever touched via
# `DATABASE_URL="$PRODUCTION_DATABASE_URL" npm run migrate:deploy`, once a
# migration is verified against DATABASE_URL above. See
# docs/DATABASE_DEPLOYMENT.md.
PRODUCTION_DATABASE_URL="postgresql://user:password@localhost:5432/chitchat?schema=public"

# Authentication
JWT_SECRET="dev-secret-key-change-in-prod"
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="dev-refresh-secret-key-change-in-prod"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=1
# SMS Provider: 'console' (dev) or 'twilio' (prod)
SMS_PROVIDER=console

# Twilio (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
# At least one of GOOGLE_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID must be set, or
# Google sign-in is refused outright — without a configured audience, the ID
# token's `aud` claim can't be checked, which would accept tokens minted for
# any Google OAuth client, not just this app's.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Firebase Admin (call push notifications — wakes the Android app for incoming
# calls when backgrounded/killed). Paste the full service account JSON as a
# single-line string. Leave unset to disable call push (calls still work over
# a live socket connection, they just won't wake a backgrounded/killed app).
FIREBASE_SERVICE_ACCOUNT_JSON=

# TURN/STUN (WebRTC call NAT traversal — see docs/NAT_STUN_TURN.md)
# TURN_SECRET must match the TURN provider's shared/static-auth secret (e.g.
# the "Secret Key" in the metered.ca dashboard used for their TURN REST API —
# NOT the long-term username/credential pair). The backend uses it to mint a
# fresh, short-lived TURN credential per call session via HMAC-SHA1.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.relay.metered.ca:80
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
